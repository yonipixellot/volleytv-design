{
  "name": "halo-design",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "bun --cwd apps/halo-angular start",
    "build": "bun --cwd apps/halo-angular build",
    "test": "bun --cwd apps/halo-angular test",
    "lint:spacing": "bun --cwd apps/halo-angular lint:spacing",
