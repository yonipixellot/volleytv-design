# Access control for the Vercel-only preview deploy (see src/preview-gate/gate.ts).
# Supabase Auth only — no database tables. Not used by the GitHub Pages deploy.
#
# Get these from the Supabase project's Settings → API page and set them in
# Vercel → Project → Settings → Environment Variables. tools/gen-preview-env.mjs
# bakes them into the bundle at build time, so changing them needs a re-deploy.
#
# The NEXT_PUBLIC_ prefix is kept so the vars already set on the Vercel project
# for the old Next.js design-preview deploy keep working as-is. The unprefixed
# SUPABASE_URL / SUPABASE_ANON_KEY are also accepted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
